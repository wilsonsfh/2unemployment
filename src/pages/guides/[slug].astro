---
import type {InferGetStaticPropsType,MarkdownInstance} from 'astro';
import Page from '../../layouts/Page.astro';

export const prerender=true;
export function getStaticPaths() {
 const guides=import.meta.glob<MarkdownInstance<Record<string,unknown>>>('../../../docs/*.md',{eager:true});
 return Object.entries(guides).map(([path,guide])=>({params:{slug:path.split('/').pop()!.replace(/\.md$/,'')},props:{guide}}));
}
const {guide}=Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const {Content,getHeadings}=guide;
const headings=getHeadings();
const title=headings.find(heading=>heading.depth===1)?.text||'Project guide';
const sections=headings.filter(heading=>heading.depth===2);
const setup=Astro.params.slug==='build-your-own-board';
---
<Page title={`${title} — 2unemployment`} description={setup?'An end-to-end guide to running, adapting and deploying your own source-linked job board.':'2unemployment project guidance: setup, architecture, source evidence and responsible data use.'}>
 <a class="guide-skip" href="#guide-content">Skip to guide</a>
 <header class="topbar guide-topbar">
  <a class="wordmark" href="/" aria-label="2unemployment job board"><img class="brand-logo" src="/brand/logo.svg" alt="2unemployment" width="142" height="63"/></a>
  <nav aria-label="Guide navigation"><a href="/">Find a role</a><a href="/guides/build-your-own-board" aria-current={setup?'page':undefined}>Build your own</a><a href="/guides/licensing-and-data-use" aria-current={Astro.params.slug==='licensing-and-data-use'?'page':undefined}>Data use</a></nav>
 </header>
 <main class="guide-page">
  <div class="guide-crumb"><a href="/">Job board</a><span aria-hidden="true">/</span><span>Project guides</span></div>
  <div class="guide-layout">
   <aside class="guide-index">
    <details open>
     <summary>On this page</summary>
     <nav aria-label="On this page"><ol>{sections.map(section=><li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav>
    </details>
    <a class="guide-source" href={`https://github.com/wilsonsfh/2unemployment/blob/main/docs/${Astro.params.slug}.md`}>Read on GitHub ↗</a>
   </aside>
   <article id="guide-content" class="guide-prose" tabindex="-1">
    <div class="eyebrow">2UNEMPLOYMENT / {setup?'BUILD YOUR OWN BOARD':'PROJECT GUIDE'}</div>
    <Content />
    <div class="guide-end"><a href="/">← Back to the job board</a><a href="/guides/licensing-and-data-use#corrections-permissions-and-removal-requests">Report a correction →</a></div>
   </article>
  </div>
 </main>
 <script is:inline src="/guide-index.js" defer></script>
</Page>

<style>
 .guide-skip{position:absolute;left:20px;top:-100px;padding:12px;background:white;z-index:10}.guide-skip:focus{top:12px}
 .guide-topbar{gap:60px}.guide-topbar nav{gap:28px;align-items:center;font-size:13px}.guide-topbar a[aria-current=page]{color:var(--green);font-weight:650}
 .guide-page{max-width:1320px;margin:auto;padding:0 40px 80px}.guide-crumb{display:flex;gap:12px;padding:28px 0 36px;font-size:12px;color:#677667}
 .guide-layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:64px;align-items:start}.guide-index{position:sticky;top:28px;font-size:12px;line-height:1.6}.guide-index summary{font-weight:650;font-size:13px;cursor:pointer}.guide-index ol{list-style:none;padding:8px 0 0;margin:0}.guide-index li{margin:0 0 12px}.guide-index a{display:block}.guide-source{border-top:1px solid var(--line);padding-top:20px;margin-top:24px;color:var(--green)}
 .guide-prose{min-width:0;width:100%;max-width:78ch;font-size:15px;line-height:1.85;overflow-wrap:anywhere}.guide-prose:focus{outline:none}.guide-prose .eyebrow{margin:0 0 22px}
 .guide-prose :global(h1){font-size:clamp(30px,4vw,46px);line-height:1.14;letter-spacing:-1.5px;margin:0 0 24px;text-wrap:balance}
 .guide-prose :global(h2){font-size:26px;line-height:1.3;letter-spacing:-.7px;margin:56px 0 20px;padding-top:20px;border-top:1px solid var(--line);scroll-margin-top:28px}
 .guide-prose :global(h3){font-size:19px;line-height:1.4;margin:32px 0 14px;scroll-margin-top:28px}.guide-prose :global(p){margin:0 0 20px}.guide-prose :global(a){color:var(--green);text-decoration:underline;text-underline-offset:3px}.guide-prose :global(li){margin-bottom:10px}.guide-prose :global(ul),.guide-prose :global(ol){padding-left:24px;margin:0 0 24px}
 .guide-prose :global(img){max-width:100%;height:auto}.guide-prose :global(img[alt="2unemployment logo"]){width:142px;margin:0 0 8px}
 .guide-prose :global(pre){max-width:100%;overflow:auto;padding:22px 24px;border-radius:6px;font-size:12px;line-height:1.8;margin:24px 0;overflow-wrap:normal;tab-size:2}.guide-prose :global(code){font-size:.88em}.guide-prose :global(:not(pre)>code){background:#eef1e9;padding:2px 5px;border-radius:3px}
 .guide-prose :global(table){display:block;overflow:auto;max-width:100%;border-collapse:collapse;margin:24px 0 32px;font-size:13px;line-height:1.7}.guide-prose :global(th),.guide-prose :global(td){text-align:left;vertical-align:top;padding:14px 16px;min-width:160px;border-bottom:1px solid var(--line)}.guide-prose :global(th){color:var(--green);background:#edf1e7}.guide-prose :global(blockquote){border-left:3px solid #b6caa6;padding-left:20px;margin:24px 0;color:#596851}
 .guide-end{display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;border-top:1px solid var(--line);padding-top:28px;margin-top:56px;font-size:13px}
 @media(max-width:950px){.guide-layout{grid-template-columns:190px minmax(0,1fr);gap:32px}.guide-page{padding:0 24px 60px}}
 @media(max-width:700px){.guide-topbar{height:auto;min-height:70px;flex-wrap:wrap;gap:0;padding-bottom:14px}.guide-topbar nav{display:flex;width:100%;gap:24px;font-size:12px}.guide-page{padding:0 20px 48px}.guide-crumb{padding:22px 0}.guide-layout{display:flex;flex-direction:column;gap:30px}.guide-index{position:static;width:100%;font-size:13px;border-bottom:1px solid var(--line);padding-bottom:24px}.guide-index li{margin-bottom:10px}.guide-index ol{columns:2;column-gap:24px;padding-top:16px}.guide-index li{break-inside:avoid}.guide-source{margin-top:12px;padding-top:16px}.guide-prose{font-size:14px}.guide-prose :global(h2){font-size:23px;margin-top:40px}.guide-prose :global(pre){padding:18px 16px}}
 @media(max-width:400px){.guide-index ol{columns:1}}
</style>
