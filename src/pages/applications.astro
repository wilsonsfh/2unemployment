---
import Page from '../layouts/Page.astro';
import Applications from '../components/Applications';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Vary','Cookie');
---
<Page title="Your applications — 2unemployment" description="Private application tracking across devices. Save jobs, statuses, application dates and notes." noindex>
 <header class="topbar application-topbar"><a class="wordmark" href="/"><img class="brand-logo" src="/brand/logo.svg" alt="2unemployment" width="142" height="63"/></a><nav aria-label="Main navigation"><a href="/">Find a role</a><a href="/applications" aria-current="page">Applications</a><a href="/guides/build-your-own-board">Build your own</a></nav></header>
 <main class="applications-page"><Applications client:load /></main>
</Page>
<style is:global>
 .application-topbar{gap:60px}.application-topbar nav{align-items:center;font-size:13px}.application-topbar a[aria-current=page]{font-weight:650;color:var(--green)}
 .applications-page{max-width:1320px;margin:auto;padding:48px 40px 72px}.application-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:36px}.application-heading>.secondary{white-space:nowrap;flex-shrink:0}.application-heading p{margin-top:16px;color:#697968;line-height:1.7}.application-heading .eyebrow{margin-bottom:14px}
 .applications-page h2{font-size:23px;line-height:1.4;letter-spacing:-.6px;font-weight:550}.applications-page p{line-height:1.8}.applications-page label{display:flex;flex-direction:column;gap:9px;font-size:12px;font-weight:600;margin-bottom:22px}.applications-page input,.applications-page select,.applications-page textarea{border:1px solid #ccd6c7;background:white;border-radius:5px;padding:12px;color:var(--green);width:100%;font:inherit;font-size:14px;line-height:1.6}.applications-page textarea{resize:vertical}.applications-page .primary,.applications-page .secondary{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:11px 18px;font-size:12px;border-radius:5px}.applications-page .secondary{border:1px solid #cdd8c7;background:white}.applications-page button:disabled{opacity:.5;cursor:not-allowed}.applications-page .text-button{font-size:12px;line-height:1.6;padding:8px 0}.application-muted{color:#71806a;font-size:12px}.applications-page a:not(.wordmark){text-decoration:underline;text-underline-offset:3px}
 .application-message{padding:15px 18px;margin-bottom:24px;background:#eaf0df;border-left:3px solid #66864f;font-size:13px;line-height:1.7}.application-message.error{background:#f7eee4;border-color:#a57543}.application-message button{margin-left:16px;text-decoration:underline}
 .application-login{display:grid;grid-template-columns:1fr 1fr;gap:90px;max-width:1000px;border-top:1px solid var(--line);padding-top:36px}.application-login p{margin:18px 0}.application-login ul{padding-left:19px;line-height:2.3;font-size:13px;margin:22px 0}.application-login a{font-size:13px}.social-signin{display:grid;gap:12px;margin-bottom:28px}.application-login-form form{border-top:1px solid var(--line);padding-top:24px}.application-login-form form>.primary{width:100%}.application-login-form .text-button{margin-top:14px}
 .application-account{display:flex;justify-content:space-between;gap:16px;padding:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:12px;color:#677560}.application-toolbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:26px 0}.application-toolbar label{flex-direction:row;align-items:center;gap:12px;margin:0 auto 0 0}.application-toolbar select{width:180px;padding:8px 12px}.external-application{padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:28px;max-width:700px}.external-application h2{margin-bottom:22px}.external-application p{margin-bottom:18px}
 .application-workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);border-top:1px solid var(--line);min-height:440px}.application-list{border-right:1px solid var(--line)}.application-row{display:block;width:100%;text-align:left;padding:24px;border-bottom:1px solid var(--line);border-left:3px solid transparent}.application-row.selected{background:#edf2e5;border-left-color:var(--green)}.application-company{display:block;font-size:12px;color:#6e7c63;margin-bottom:8px}.application-row strong{display:block;font-size:15px;font-weight:550;line-height:1.6;margin-bottom:12px}.application-stage{display:inline-block;font-size:11px;border:1px solid #ccd8c0;border-radius:4px;padding:3px 8px}.stage-offer{background:#d9edb9}.stage-rejected,.stage-withdrawn{color:#817366}.application-row small{font-size:11px;color:#71806a;margin-top:12px}.application-editor{padding:28px 0 28px 36px;min-width:0}.application-editor h2{margin-bottom:16px}.application-links{display:flex;flex-wrap:wrap;gap:18px;font-size:12px;margin-bottom:28px}.application-editor-actions{display:flex;align-items:center;gap:16px}.application-editor-actions span{font-size:12px;color:#8a714c}.application-remove{border-top:1px solid var(--line);padding-top:22px;margin-top:30px}.application-remove p{font-size:12px;margin-bottom:12px}.application-remove .text-button{margin-left:14px}.application-empty{padding:38px 26px 38px 0}.application-empty p{font-size:13px;color:#71806a;margin:16px 0}.application-empty a{font-size:13px}.application-pagination{display:flex;justify-content:flex-end;gap:14px;align-items:center;margin-top:24px;font-size:12px}.application-pagination>span{margin-right:auto}
 @media(max-width:700px){.application-topbar{height:auto;gap:0;padding-bottom:14px;flex-wrap:wrap}.application-topbar nav{display:flex;width:100%;gap:24px;font-size:12px}.applications-page{padding:30px 20px 48px}.application-heading{align-items:flex-start;margin-bottom:28px}.application-heading h1{font-size:34px}.application-heading>.secondary{white-space:nowrap;flex-shrink:0}.application-heading p{font-size:13px}.application-login{grid-template-columns:1fr;gap:28px;padding-top:26px}.application-login h2,.applications-page h2{font-size:21px}.application-login p{font-size:13px}.application-workspace{grid-template-columns:1fr}.application-list{border-right:0}.application-editor{padding:28px 0;border-top:1px solid var(--line)}.application-account{flex-direction:column;font-size:11px;gap:8px}.application-toolbar label{width:100%;margin-bottom:4px}.application-toolbar select{flex:1}.application-toolbar .primary,.application-toolbar .secondary{flex:1}.application-row{padding:20px 16px}.application-pagination{gap:8px;font-size:11px}.application-pagination .secondary{padding:9px 12px}.applications-page input,.applications-page select,.applications-page textarea{font-size:16px}}
</style>
